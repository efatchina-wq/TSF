# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENVIRONMENT CONFIGURATION (development | staging | production)
NODE_ENV="development"
PORT="3000"

# SECURITY & AUTHENTICATION
JWT_SECRET="tsf_dev_jwt_secret_must_be_changed_in_production_environment"
SESSION_TTL_HOURS="24"

# RATE LIMITING & SECURITY
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="120"

# EMAIL / SMTP DISPATCH SERVICE (External Integration)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Talents Sans Frontières <notifications@tsf.africa>"

# CLOUD STORAGE (CV, portfolios, certificates, documents)
STORAGE_DRIVER="local"
STORAGE_BUCKET="tsf-media-vault"
STORAGE_BASE_PATH="./data/storage"

# BACKUP & DATA GOVERNANCE
BACKUP_RETENTION_DAYS="30"
BACKUP_SNAPSHOT_DIR="./data/backups"
